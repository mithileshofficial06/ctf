# Copy to .env.local and fill in real values. .env.local is gitignored.
# Every value here is a PLACEHOLDER — nothing in this file is a real credential.

# ── Database ───────────────────────────────────────────────────────────────
# Cosmos DB for MongoDB connection string.
# Leave retrywrites=false as Cosmos supplies it. Do NOT set retryWrites=true:
# Cosmos rejects retryable writes on WRITE rather than on connect, so the app
# looks perfectly healthy until the first flag is submitted.
MONGODB_URI="mongodb://<account>:<key>@<account>.mongo.cosmos.azure.com:10255/?ssl=true&retrywrites=false&appName=@<account>@"
MONGODB_DB="xplore26"

# ── Sessions ───────────────────────────────────────────────────────────────
# Signing key for the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<random-48-byte-base64url-string>"

# Root domain the session cookie is scoped to. A leading dot makes one login
# valid across every event subdomain. Leave unset for local development.
# COOKIE_DOMAIN=".xplore26.xyz"

# ── CTF attachments (Azure Blob Storage) ───────────────────────────────────
# Must carry an account KEY, not a token credential — the app signs short-lived
# SAS URLs with it, and a token credential cannot sign a service SAS.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# The container holding challenge files. MUST be private: a public container
# lets anyone enumerate challenge files before the event opens.
AZURE_STORAGE_CTF_CONTAINER="ctf-attachments"

# ── CTF organiser view ─────────────────────────────────────────────────────
# There is no host key: teams start their own clocks, so nothing needs starting
# centrally. The organiser console lives at /adminofctf and is guarded only by
# knowing that path, which is why it shows no flags and no submitted answers.
# Treat the URL as semi-public and keep it off the projector.
